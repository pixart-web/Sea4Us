{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{ "slug": "deep", "name": "Azul profundo", "color": "#071F2B" },
				{ "slug": "petrol", "name": "Petróleo", "color": "#0B5362" },
				{ "slug": "turquoise", "name": "Turquesa (acento sobre escuro)", "color": "#39B8BC" },
				{ "slug": "turquoise-ink", "name": "Turquesa (texto sobre claro)", "color": "#07707A" },
				{ "slug": "mineral", "name": "Branco mineral", "color": "#F4F8F7" },
				{ "slug": "slate", "name": "Cinzento azulado", "color": "#667985" },
				{ "slug": "slate-ink", "name": "Cinzento azulado (texto)", "color": "#55687A" },
				{ "slug": "white", "name": "Branco", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display", "name": "Manrope", "fontFamily": "Manrope, \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				},
				{
					"slug": "body", "name": "Inter", "fontFamily": "Inter, \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
						{ "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-wght-italic.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeno", "size": "0.875rem" },
				{ "slug": "medium", "name": "Base", "size": "1.0625rem" },
				{ "slug": "large", "name": "Destaque", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Título 3", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "Título 2", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" }
			]
		},
		"blocks": {
			"core/button": { "border": { "radius": false } }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--deep)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.12", "letterSpacing": "-0.02em" } },
			"h1": { "typography": { "fontSize": "clamp(2.5rem, 5vw, 4.25rem)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"link": { "color": { "text": "var(--wp--preset--color--petrol)" }, ":hover": { "color": { "text": "var(--wp--preset--color--deep)" } } },
			"button": { "color": { "background": "var(--wp--preset--color--petrol)", "text": "var(--wp--preset--color--white)" }, "typography": { "fontWeight": "600" }, "border": { "radius": "999px" } }
		}
	}
}
