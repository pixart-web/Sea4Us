  },
  "pt": {
   "title": "Pedro A. Lima",
   "slug": "pedro-lima",
   "excerpt": "",
   "content": "<p><a href=\"https://www.linkedin.com/in/pedro-afonso-lima/\">Pedro</a> é um investigador sénior (doutorado), neurofisiologista, biólogo marinho e fundador da Sea4Us. Licenciado em Biologia Marinha pela Universidade do Algarve e doutorado em Neurofisiologia pela Universidade de Sheffield / Associação de Biologia Marinha de Plymouth, no Reino Unido, tem uma vasta experiência em atividades de I&amp;D, com especial ênfase na investigação científica em Neurociências e Fisiologia. Desde 2010, tem o seu laboratório na NOVA Medical School, onde ensina Fisiologia a estudantes de medicina. Pedro é responsável pela gestão geral da empresa, coordenando também a gestão de todas as atividades científicas internas e de entidades técnicas, científicas e de consultoria externas, garantindo a correta execução dos objetivos dos projetos de I&amp;D. A gestão diária das atividades de I&amp;D é apoiada por André Bastos.</p>",
   "fields": {
    "role": "Presidente do Conselho de Administração, Diretor-Geral; Diretor Científico",
    "group": "Conselho de Administração",
    "credentials": "PhD",
    "expertise": ""
   }
  },
  "en": {
   "title": "Pedro A. Lima",
   "slug": "pedro-lima",
   "excerpt": "",
   "content": "<p>Pedro (<a href=\"https://www.linkedin.com/in/pedro-afonso-lima/\">LinkedIn</a>) is a Senior Researcher (doctorate), Neurophysiologist, Marine Biologist and founder of Sea4Us. With a degree in Marine Biology from the University of Algarve and PhD in Neurophysiology from the University of Sheffield / Plymouth Marine Biological Association of the UK, he has a vast experience in R&amp;D activities, with special emphasis on scientific research in Neurosciences and Physiology. Since 2010 he has had his laboratory at NOVA Medical School, where he teaches Physiology to medical students. Pedro is responsible for the general management of the company, coordinating also the management of all internal scientific activities and external technical, scientific and consulting entities, assuring the correct execution of the R&amp;D objectives of the projects. The daily management of R&amp;D activities is supported by André Bastos.</p>",
   "fields": {
    "role": "President of the Board, CEO, CSO",
    "group": "Board of Directors",
    "credentials": "PhD",
    "expertise": ""
   }
  }
 },
